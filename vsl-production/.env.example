# vsl-production — variaveis de ambiente
# Copie este arquivo para vsl-production/.env e preencha os valores.
# NUNCA commite o .env (ja esta no .gitignore da raiz).

# OpenAI (DALL-E 3 / TTS / Whisper)
# Usado por: generate_vsl.py, kling_submit.py, add_subtitles.py, fix_and_finish.py,
#            regen_creatives.py, generate_ad_images.py, generate_ad_images_v2.py, generate_images_v2.py
OPENAI_API_KEY=

# OpenRouter (Seedream / Gemini / GPT image)
# Usado por: gen_all.py, instagram/gen_instagram.py, instagram/gen_stories.py
OPENROUTER_API_KEY=

# Kling AI (image-to-video) — access key + secret key
# Usado por: generate_vsl.py, kling_submit.py, kling_rerun.py, fix_and_finish.py, regen_creatives.py
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Meta Ads (Graph API access token)
# Usado por: meta_upload.py, meta_relaunch.py, meta_upload_campaign.py, meta_update_copies.py
META_ACCESS_TOKEN=

# Replicate (Veo 3.1 / Seedream)
# Usado por: pet_clipper/generate_videos.py, pet_clipper/generate_product_images.py
REPLICATE_API_TOKEN=

# Instagram (conta @madamauroraofficial)
# Usado por: instagram/*.py (post, highlights, setup de perfil, etc.)
IG_USERNAME=
IG_PASSWORD=

# Google Ads (OAuth2 + developer token)
# Usado por: get_google_token.py e google_ads.yaml
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
